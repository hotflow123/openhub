{
  "name": "@openhub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:push": "drizzle-kit push --force",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:param-limits": "node tools/migrate-param-limits.cjs",
    "db:migrate:schema-evidence": "node tools/migrate-schema-match-evidence.cjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "catalog:coverage": "tsx --env-file=.env tools/analyze-catalog-coverage.ts",
    "catalog:init": "tsx --env-file=.env scripts/init.ts",
    "init": "tsx --env-file=.env scripts/init.ts",
    "sync:fal": "tsx src/scripts/sync-fal-encyclopedia.ts",
    "sync:oga": "tsx src/scripts/sync-open-generative-ai.ts",
    "test": "tsx --test test-model-contract.ts test-param-mapper.ts test-open-generative-ai.ts test-memefast-protocol.ts test-memefast-adapter.ts test-publication-policy.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.17.4",
    "@openhub/catalog": "workspace:*",
    "better-sqlite3": "^11.2.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.5.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
