# 必填：站点 API Key 加密主密钥（生产环境用 32 字节随机串）
OPENHUB_MASTER_KEY=dev-master-key-please-change-in-production

# 可选：监听端口（默认 3000）
PORT=3000

# 可选：数据库文件位置（默认 ./data/openhub.db）
OPENHUB_DB_URL=./data/openhub.db

# 可选：models.dev 目录地址
MODELS_DEV_URL=https://models.dev/models.json

# 可选：管理后台初始账号（首次启动时创建）
OPENHUB_ADMIN_USERNAME=admin
OPENHUB_ADMIN_PASSWORD=admin123