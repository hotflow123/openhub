# 必填：站点 API Key 加密主密钥（生产环境用 32 字节随机串）
OPENHUB_MASTER_KEY=dev-master-key-please-change-in-production

# 可选：运行环境；production 才会启用周期目录同步
NODE_ENV=development

# 可选：监听端口（默认 3000）
PORT=3000

# 可选：数据库文件位置（默认 ./data/openhub.db）
OPENHUB_DB_URL=./data/openhub.db

# 可选：Open-Generative-AI 参数模板快照路径；默认按服务端模块位置解析
OPENHUB_PARAMETER_TEMPLATE_SNAPSHOT_PATH=

# 可选：models.dev 目录地址
MODELS_DEV_URL=https://models.dev/models.json

# 可选：目录同步周期（production，毫秒，最小 60000）
CATALOG_SYNC_INTERVAL_MS=21600000

# 可选：目录同步请求超时（毫秒，最小 1000）
CATALOG_SYNC_TIMEOUT_MS=30000

# 可选：管理后台初始账号（首次启动时创建）
OPENHUB_ADMIN_USERNAME=admin
OPENHUB_ADMIN_PASSWORD=admin123
