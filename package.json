{
  "name": "openhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @openhub/server dev",
    "web:dev": "pnpm --filter @openhub/web dev",
    "db:push": "pnpm --filter @openhub/server db:push",
    "db:migrate": "pnpm --filter @openhub/server db:migrate",
    "db:studio": "pnpm --filter @openhub/server db:studio",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}